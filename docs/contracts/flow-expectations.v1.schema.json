{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeflow.local/contracts/flow-expectations.v1.schema.json",
  "title": "CodeFlow flow expectations v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "flows"],
  "properties": {
    "version": { "const": "1" },
    "flows": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "required_results": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^route:/" }
          },
          "required_causal_kinds": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "allowed_debt_reasons": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "max_open_debt": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
