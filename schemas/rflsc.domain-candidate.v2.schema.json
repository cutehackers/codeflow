{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeflow.local/schemas/rflsc.domain-candidate.v2.schema.json",
  "title": "RFL-SC Domain Candidate v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["domainId", "name", "responsibility", "description", "representativeFlowCount", "entryPoints", "rationale", "evidenceRefs", "confidence", "epistemicState", "coverageBoundary", "selectionReason", "redactionStatus"],
  "properties": {
    "domainId": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "responsibility": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "representativeFlowCount": { "type": "integer", "minimum": 0 },
    "entryPoints": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "rationale": { "type": "string", "minLength": 1 },
    "evidenceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "ownershipEvidenceRefs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "glossaryEvidenceRefs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "epistemicState": { "enum": ["candidate", "confirmed", "unknown"] },
    "coverageBoundary": { "$ref": "#/$defs/coverageBoundary" },
    "selectionReason": { "type": "string", "minLength": 1 },
    "redactionStatus": { "enum": ["clean", "redacted"] },
    "missingEvidence": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "coverageBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["includedSourceRoots", "excludedReasons"],
      "properties": {
        "includedSourceRoots": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "excludedReasons": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
