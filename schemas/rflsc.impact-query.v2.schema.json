{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeflow.local/schemas/rflsc.impact-query.v2.schema.json",
  "title": "RFL-SC Impact Query v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "target",
    "computedBasisId",
    "generationId",
    "freshness",
    "maxDepth",
    "maxNodes",
    "relationKinds",
    "coverageComplete",
    "currentProofVerified"
  ],
  "properties": {
    "schemaId": { "const": "https://codeflow.local/schemas/rflsc.impact-query.v2.schema.json" },
    "schemaVersion": { "const": 2 },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "symbolId": { "type": "string", "minLength": 1 },
        "changeBatchId": { "type": "string", "minLength": 1 }
      },
      "oneOf": [
        { "required": ["symbolId"], "not": { "required": ["changeBatchId"] } },
        { "required": ["changeBatchId"], "not": { "required": ["symbolId"] } }
      ]
    },
    "computedBasisId": { "type": "string", "minLength": 1 },
    "generationId": { "type": "string", "minLength": 1 },
    "freshness": { "enum": ["current", "historical"] },
    "maxDepth": { "type": "integer", "minimum": 1, "maximum": 5 },
    "maxNodes": { "type": "integer", "minimum": 1, "maximum": 50 },
    "relationKinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "calls",
          "overrides",
          "instantiates",
          "state_mutation",
          "external_effect",
          "related_test",
          "related_flow"
        ]
      }
    },
    "changeBatchStepRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "coverageComplete": { "type": "boolean" },
    "currentProofVerified": { "type": "boolean" }
  }
}
