{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeflow.local/schemas/rflsc.approval-aggregate.v2.schema.json",
  "title": "RFL-SC Approval Aggregate v2",
  "description": "The replay-derived approval aggregate and its ordered version history.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "aggregateId",
    "workspaceId",
    "proposalId",
    "evidencePackId",
    "computedBasisId",
    "generationId",
    "intentRevision",
    "version",
    "state",
    "lastEventId",
    "lastDecision",
    "history"
  ],
  "properties": {
    "schemaId": { "const": "https://codeflow.local/schemas/rflsc.approval-aggregate.v2.schema.json" },
    "schemaVersion": { "const": 2 },
    "aggregateId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "workspaceId": { "type": "string", "maxLength": 256 },
    "proposalId": { "type": "string", "maxLength": 256 },
    "evidencePackId": { "type": "string", "maxLength": 256 },
    "computedBasisId": { "type": "string", "maxLength": 256 },
    "generationId": { "type": "string", "maxLength": 256 },
    "intentRevision": { "type": "integer", "minimum": 1, "maximum": 1000000 },
    "version": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
    "state": { "enum": ["none", "active", "rejected", "revoked", "superseded"] },
    "lastEventId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "lastDecision": { "enum": ["none", "approve", "edit_then_approve", "reject", "revoke", "supersede"] },
    "activeApprovalId": { "type": "string", "maxLength": 256 },
    "history": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/historyEntry" }
    }
  },
  "$defs": {
    "historyEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "state", "eventId", "decision"],
      "properties": {
        "version": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "state": { "enum": ["none", "active", "rejected", "revoked", "superseded"] },
        "eventId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "approvalId": { "type": "string", "maxLength": 256 },
        "decision": { "enum": ["none", "approve", "edit_then_approve", "reject", "revoke", "supersede"] }
      }
    }
  }
}
