{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeflow.local/schemas/change-batch.schema.json",
  "title": "CodeFlow Change Batch",
  "$comment": "Raw §7.5 and VS-03 normative schema for ChangeBatch multi-file transactions and coalesced edit batches.",
  "type": "object",
  "required": [
    "schemaId",
    "schemaVersion",
    "batchId",
    "source",
    "workspaceEpoch",
    "revisions",
    "status",
    "createdAt"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaId": {
      "type": "string",
      "enum": [
        "https://codeflow.local/schemas/change-batch.schema.json",
        "codeflow.change-batch"
      ]
    },
    "schemaVersion": { "const": 1 },
    "batchId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "transactionId": { "type": ["string", "null"] },
    "source": {
      "type": "string",
      "enum": ["agent_transaction", "ide_versioned", "watcher_fallback"]
    },
    "workspaceEpoch": { "type": "string", "minLength": 1 },
    "revisions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "status": {
      "type": "string",
      "enum": ["open", "committed", "aborted"]
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "committedAt": { "type": ["string", "null"], "format": "date-time" }
  }
}
