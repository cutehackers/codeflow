{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeflow.local/schemas/rflsc.approval-command.v2.schema.json",
  "title": "RFL-SC Approval Command v2",
  "description": "An actor-attributed approval lifecycle command bound to one proposal, pack, basis and generation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "commandId",
    "actorId",
    "sessionId",
    "workspaceId",
    "proposalId",
    "evidencePackId",
    "computedBasisId",
    "generationId",
    "intentRevision",
    "decision",
    "idempotencyKey",
    "expectedApprovalVersion",
    "expectedState"
  ],
  "properties": {
    "schemaId": { "const": "https://codeflow.local/schemas/rflsc.approval-command.v2.schema.json" },
    "schemaVersion": { "const": 2 },
    "commandId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "actorId": { "type": "string", "maxLength": 256 },
    "sessionId": { "type": "string", "maxLength": 256 },
    "workspaceId": { "type": "string", "maxLength": 256 },
    "proposalId": { "type": "string", "maxLength": 256 },
    "evidencePackId": { "type": "string", "maxLength": 256 },
    "computedBasisId": { "type": "string", "maxLength": 256 },
    "generationId": { "type": "string", "maxLength": 256 },
    "intentRevision": { "type": "integer", "minimum": 1, "maximum": 1000000 },
    "decision": { "enum": ["approve", "edit_then_approve", "reject", "revoke", "supersede"] },
    "editedText": { "type": "string", "maxLength": 4096 },
    "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 256 },
    "expectedApprovalVersion": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
    "expectedState": { "enum": ["none", "active", "rejected", "revoked", "superseded"] },
    "predecessorApprovalId": { "type": "string", "maxLength": 256 }
  }
}
