{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeflow.local/schemas/rflsc.release-profile.v2.schema.json",
  "title": "Declared release environment profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaId", "schemaVersion", "targetVersion", "profileId", "artifactRef", "os", "architecture", "hardware", "repository", "toolchains", "activeScope", "loadProfile", "capabilities"],
  "properties": {
    "schemaId": {"const": "https://codeflow.local/schemas/rflsc.release-profile.v2.schema.json"},
    "schemaVersion": {"const": 2},
    "targetVersion": {"type": "string", "minLength": 1},
    "profileId": {"type": "string", "minLength": 1},
    "artifactRef": {"$ref": "#/$defs/immutableRef"},
    "os": {"type": "string", "minLength": 1},
    "architecture": {"type": "string", "minLength": 1},
    "hardware": {
      "type": "object", "additionalProperties": false,
      "required": ["cpu", "logicalCpus", "memoryBytes"],
      "properties": {"cpu": {"type": "string", "minLength": 1}, "logicalCpus": {"type": "integer", "minimum": 1}, "memoryBytes": {"type": "integer", "minimum": 1}}
    },
    "repository": {
      "type": "object", "additionalProperties": false,
      "required": ["shape", "fileCount", "bytes", "languages", "fixtureRef"],
      "properties": {
        "shape": {"type": "string", "minLength": 1}, "fileCount": {"type": "integer", "minimum": 1}, "bytes": {"type": "integer", "minimum": 1},
        "languages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "fixtureRef": {"$ref": "#/$defs/immutableRef"}
      }
    },
    "toolchains": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "additionalProperties": false, "required": ["toolchainId", "name", "version", "artifactRef"], "properties": {"toolchainId": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "artifactRef": {"$ref": "#/$defs/immutableRef"}}}
    },
    "activeScope": {"type": "string", "minLength": 1},
    "loadProfile": {"type": "string", "minLength": 1},
    "browser": {"type": "string", "minLength": 1},
    "capabilities": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "additionalProperties": false, "required": ["capabilityId", "requiredScenarios", "childEvidenceIds"], "properties": {
        "capabilityId": {"type": "string", "minLength": 1},
        "requiredScenarios": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "childEvidenceIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }}
    }
  },
  "$defs": {"immutableRef": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
