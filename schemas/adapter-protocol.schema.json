{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeflow.local/schemas/adapter-protocol.schema.json",
  "title": "CodeFlow Adapter Protocol (JSON-RPC 2.0 over Content-Length framed stdio)",
  "$comment": "VS-01. Production adapter traffic is JSON-RPC 2.0 framed by Content-Length. The legacy branch is retained only for historical fixtures and direct helper compatibility.",
  "oneOf": [
    { "$ref": "#/$defs/jsonrpcRequest" },
    { "$ref": "#/$defs/jsonrpcResponse" },
    { "$ref": "#/$defs/notification" },
    { "$ref": "#/$defs/legacyRequest" },
    { "$ref": "#/$defs/legacyResponse" }
  ],
  "$defs": {
    "jsonrpc": { "const": "2.0" },
    "requestId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "params": { "type": "object" },
    "methods": {
      "type": "string",
      "enum": ["initialize", "ping", "detect", "harvest_candidates", "slice", "shutdown"]
    },
    "notificationMethods": {
      "type": "string",
      "enum": ["$/cancelRequest", "$/progress", "codeflow/diagnostic", "codeflow/batchAck"]
    },
    "jsonrpcRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "$ref": "#/$defs/jsonrpc" },
        "id": { "$ref": "#/$defs/requestId" },
        "method": { "$ref": "#/$defs/methods" },
        "params": { "$ref": "#/$defs/params" }
      }
    },
    "notification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "method", "params"],
      "properties": {
        "jsonrpc": { "$ref": "#/$defs/jsonrpc" },
        "method": { "$ref": "#/$defs/notificationMethods" },
        "params": { "$ref": "#/$defs/params" }
      }
    },
    "jsonrpcResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id"],
      "properties": {
        "jsonrpc": { "$ref": "#/$defs/jsonrpc" },
        "id": { "$ref": "#/$defs/requestId" },
        "result": { "type": "object" },
        "error": { "$ref": "#/$defs/rpcError" }
      },
      "oneOf": [
        { "required": ["result"], "not": { "required": ["error"] } },
        { "required": ["error"], "not": { "required": ["result"] } }
      ]
    },
    "rpcError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "integer" },
        "message": { "type": "string", "minLength": 1, "maxLength": 512 },
        "data": { "type": ["object", "null"] }
      }
    },
    "legacyRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "id", "op", "params"],
      "properties": {
        "v": { "const": 1 },
        "id": { "$ref": "#/$defs/requestId" },
        "op": { "type": "string", "enum": ["ping", "detect", "harvest_candidates", "slice", "shutdown"] },
        "params": { "$ref": "#/$defs/params" }
      }
    },
    "legacyResponse": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "ok", "result"],
          "properties": {
            "id": { "$ref": "#/$defs/requestId" },
            "ok": { "const": true },
            "result": { "type": "object" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "ok", "err"],
          "properties": {
            "id": { "$ref": "#/$defs/requestId" },
            "ok": { "const": false },
            "err": { "$ref": "#/$defs/legacyError" }
          }
        }
      ]
    },
    "legacyError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": { "type": "string", "enum": ["E_TIMEOUT", "E_CANCELLED", "E_CRASHED", "E_BACKPRESSURE", "E_BAD_REQUEST", "E_UNSUPPORTED_VERSION", "E_ADAPTER_INTERNAL"] },
        "message": { "type": "string", "minLength": 1, "maxLength": 512 },
        "retryable": { "type": "boolean" },
        "detail": { "type": "string", "maxLength": 512 }
      }
    }
  }
}
