{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeflow.local/schemas/requested-flow-overview.schema.json",
  "title": "Requested Flow Overview",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaId": {
      "const": "https://codeflow.local/schemas/requested-flow-overview.schema.json"
    },
    "schemaVersion": {
      "enum": [
        1,
        2
      ]
    },
    "request": {
      "type": "string",
      "minLength": 1
    },
    "snapshotId": {
      "type": "string",
      "minLength": 1
    },
    "computedBasisId": {
      "type": "string",
      "minLength": 1
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "segmentId": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "inclusionReason": {
            "type": "string",
            "minLength": 1
          },
          "stepIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "entryStepId": {
            "type": "string",
            "minLength": 1
          },
          "blocks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "blockId": {
                  "type": "string",
                  "minLength": 1
                },
                "repoRelativePath": {
                  "type": "string",
                  "minLength": 1
                },
                "symbolPath": {
                  "type": "string",
                  "minLength": 1
                },
                "lineRange": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "stepIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1,
                  "uniqueItems": true
                },
                "highlights": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "stepId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "lineRange": {
                        "type": "array",
                        "items": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "minItems": 2,
                        "maxItems": 2
                      },
                      "byteRange": {
                        "type": "array",
                        "items": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "minItems": 2,
                        "maxItems": 2
                      },
                      "lineSelections": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "lineNumber": {
                              "type": "integer",
                              "minimum": 1
                            },
                            "startColumn": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "endColumn": {
                              "type": "integer",
                              "minimum": 0
                            }
                          },
                          "required": [
                            "lineNumber",
                            "startColumn",
                            "endColumn"
                          ]
                        }
                      }
                    },
                    "required": [
                      "stepId",
                      "lineRange",
                      "byteRange",
                      "lineSelections"
                    ]
                  }
                }
              },
              "required": [
                "blockId",
                "repoRelativePath",
                "symbolPath",
                "lineRange",
                "stepIds",
                "highlights"
              ]
            }
          }
        },
        "required": [
          "segmentId",
          "purpose",
          "inclusionReason",
          "stepIds",
          "entryStepId",
          "blocks"
        ]
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "fromSegmentId": {
            "type": "string",
            "minLength": 1
          },
          "toSegmentId": {
            "type": "string",
            "minLength": 1
          },
          "fromStepId": {
            "type": "string",
            "minLength": 1
          },
          "toStepId": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "verified",
              "boundary"
            ]
          },
          "derived": {
            "type": "boolean"
          },
          "edgeIndexes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "edges": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "fromStepId",
          "toStepId",
          "kind",
          "status",
          "derived",
          "edgeIndexes",
          "edges"
        ]
      }
    },
    "boundaries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "fromStepId": {
            "type": "string",
            "minLength": 1
          },
          "toStepId": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "fromStepId",
          "reason"
        ]
      }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "categoryId",
          "title",
          "segmentIds"
        ],
        "properties": {
          "categoryId": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "segmentIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "required": [
    "schemaId",
    "schemaVersion",
    "request",
    "snapshotId",
    "computedBasisId",
    "segments",
    "relations",
    "boundaries"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 2
          }
        }
      },
      "then": {
        "required": [
          "categories"
        ]
      },
      "else": {
        "not": {
          "required": [
            "categories"
          ]
        }
      }
    }
  ]
}
