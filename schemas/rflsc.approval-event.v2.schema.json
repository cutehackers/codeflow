{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeflow.local/schemas/rflsc.approval-event.v2.schema.json",
  "title": "RFL-SC Approval Event v2",
  "description": "An immutable committed approval lifecycle event.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "eventId",
    "approvalId",
    "aggregateId",
    "aggregateVersion",
    "actorId",
    "sessionId",
    "workspaceId",
    "proposalId",
    "evidencePackId",
    "computedBasisId",
    "generationId",
    "intentRevision",
    "decision",
    "approvedText",
    "timestamp",
    "lifecycleRelation"
  ],
  "properties": {
    "schemaId": { "const": "https://codeflow.local/schemas/rflsc.approval-event.v2.schema.json" },
    "schemaVersion": { "const": 2 },
    "eventId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "approvalId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "aggregateId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "aggregateVersion": { "type": "integer", "minimum": 1, "maximum": 1000000000 },
    "actorId": { "type": "string", "maxLength": 256 },
    "sessionId": { "type": "string", "maxLength": 256 },
    "workspaceId": { "type": "string", "maxLength": 256 },
    "proposalId": { "type": "string", "maxLength": 256 },
    "evidencePackId": { "type": "string", "maxLength": 256 },
    "computedBasisId": { "type": "string", "maxLength": 256 },
    "generationId": { "type": "string", "maxLength": 256 },
    "intentRevision": { "type": "integer", "minimum": 1, "maximum": 1000000 },
    "decision": { "enum": ["approve", "edit_then_approve", "reject", "revoke", "supersede"] },
    "approvedText": { "type": "string", "maxLength": 4096 },
    "timestamp": { "type": "string", "minLength": 1, "maxLength": 128 },
    "lifecycleRelation": { "enum": ["initial", "edit", "reject", "revoke", "supersede"] },
    "predecessorApprovalId": { "type": "string", "maxLength": 256 }
  }
}
