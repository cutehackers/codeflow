{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeflow.local/schemas/rflsc.semantic-proposal.v2.schema.json",
  "title": "RFL-SC Semantic Proposal v2",
  "description": "Display-only inferred meaning grounded in current verified Evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaId", "schemaVersion", "proposalId", "computedBasisId", "generationId", "snapshotId", "targetStepId", "targetSymbolPath", "proposedTitle", "proposedCategory", "epistemicStatus", "authority", "claimScope", "modelId", "modelRevision", "promptRevision", "schemaProfile", "packDigest", "evidenceRefs", "factDigest", "obligationDigest", "alignmentDigest", "settlementDigest"],
  "properties": {
    "schemaId": { "const": "https://codeflow.local/schemas/rflsc.semantic-proposal.v2.schema.json" },
    "schemaVersion": { "const": 2 },
    "proposalId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "computedBasisId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "generationId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "snapshotId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "targetStepId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "targetSymbolPath": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "proposedTitle": { "type": "string", "minLength": 1, "maxLength": 512 },
    "proposedCategory": { "enum": ["entry", "business_rule", "orchestration", "mutation", "infrastructure", "exit"] },
    "epistemicStatus": { "const": "inferred" },
    "authority": { "enum": ["model", "inferred"] },
    "claimScope": { "enum": ["expression_only", "display_only"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "rationale": { "type": "string", "maxLength": 4096 },
    "promptRevision": { "type": "string", "minLength": 1, "maxLength": 256 },
    "modelId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "modelRevision": { "type": "string", "minLength": 1, "maxLength": 256 },
    "schemaProfile": { "type": "string", "minLength": 1, "maxLength": 256 },
    "packDigest": { "type": "string", "minLength": 64, "pattern": "^[0-9a-f]{64}$" },
    "evidenceRefs": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
    "factDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "obligationDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "alignmentDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "settlementDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
