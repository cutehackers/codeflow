{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeflow.local/schemas/rflsc.evidence-pack.v2.schema.json",
  "title": "RFL-SC Evidence Pack v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaId", "schemaVersion", "evidencePackId", "repositoryId", "worktreeId", "snapshotId", "workspaceEpoch", "targetSymbolPath", "targetStepIds", "scopePaths", "computedBasisId", "generationId", "items", "redactionStatus", "packDigest"],
  "properties": {
    "schemaId": { "const": "https://codeflow.local/schemas/rflsc.evidence-pack.v2.schema.json" },
    "schemaVersion": { "const": 2 },
    "evidencePackId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "repositoryId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "worktreeId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "snapshotId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "workspaceEpoch": { "type": "integer", "minimum": 0 },
    "targetSymbolPath": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "targetStepIds": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
    "scopePaths": { "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 1024 } },
    "computedBasisId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "generationId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "promptRevision": { "type": "string", "maxLength": 256 },
    "items": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/item" } },
    "redactionStatus": { "enum": ["redacted", "clean"] },
    "packDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceId", "kind", "source", "content", "verified", "snapshotId", "computedBasisId", "contentDigest", "byteRange"],
      "properties": {
        "evidenceId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "kind": { "type": "string", "minLength": 1, "maxLength": 128 },
        "source": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^[^\\\\/][^\\\\]*$" },
        "content": { "type": "string", "minLength": 1, "maxLength": 32768 },
        "verified": { "const": true },
        "snapshotId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "computedBasisId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "documentRevisionId": { "type": "string", "maxLength": 256 },
        "contentDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "byteRange": { "type": "array", "prefixItems": [{ "type": "integer", "minimum": 0 }, { "type": "integer", "minimum": 0 }], "items": false, "minItems": 2, "maxItems": 2 }
      }
    }
  }
}
