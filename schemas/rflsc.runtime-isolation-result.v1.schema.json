{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeflow.local/schemas/rflsc.runtime-isolation-result.v1.schema.json",
  "title": "CodeFlow Runtime Isolation Result v1",
  "description": "Observed one-shot runtime terminal result and source-integrity evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "resultAuthority",
    "processObserved",
    "executionId",
    "consentId",
    "actorId",
    "nonce",
    "status",
    "resultCode",
    "command",
    "args",
    "commandDigest",
    "snapshotId",
    "snapshotTreeDigest",
    "recomputedTreeDigest",
    "inputTreeVerified",
    "accessScope",
    "isolationScope",
    "mountPermissionEvidence",
    "cleanup",
    "sourceWriteAuditStatus",
    "repositoryPathWriteAudit",
    "sourceIntegrityStatus",
    "evidencePromotion",
    "concurrentWorktree",
    "startedAt",
    "finishedAt"
  ],
  "properties": {
    "schemaId": { "const": "https://codeflow.local/schemas/rflsc.runtime-isolation-result.v1.schema.json" },
    "schemaVersion": { "const": 1 },
    "resultAuthority": { "const": "runtime_executor" },
    "processObserved": { "const": true },
    "executionId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "consentId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "actorId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "nonce": { "type": "string", "minLength": 16, "maxLength": 256 },
    "status": { "enum": ["success", "failure", "timeout", "cancel"] },
    "resultCode": { "type": "string", "minLength": 1, "maxLength": 256 },
    "failureReason": { "type": "string", "maxLength": 2048 },
    "command": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "args": {
      "type": "array",
      "maxItems": 256,
      "items": { "type": "string", "maxLength": 4096 }
    },
    "commandDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "snapshotId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "snapshotTreeDigest": { "type": "string", "minLength": 1, "maxLength": 256 },
    "recomputedTreeDigest": { "type": "string", "minLength": 1, "maxLength": 256 },
    "inputTreeVerified": { "const": true },
    "accessScope": { "$ref": "#/$defs/accessScope" },
    "isolationScope": { "$ref": "#/$defs/isolationScope" },
    "mountPermissionEvidence": { "$ref": "#/$defs/mountPermissionEvidence" },
    "cleanup": { "$ref": "#/$defs/cleanup" },
    "sourceWriteAuditStatus": { "enum": ["clean", "source_integrity_violation", "unavailable", "indeterminate"] },
    "repositoryPathWriteAudit": { "$ref": "#/$defs/writeAudit" },
    "sourceIntegrityStatus": { "enum": ["clean", "source_integrity_violation", "audit_unavailable", "audit_indeterminate"] },
    "evidencePromotion": { "enum": ["eligible", "blocked"] },
    "promotionBlockedReason": { "type": "string", "maxLength": 512 },
    "concurrentWorktree": { "$ref": "#/$defs/concurrentWorktree" },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "output": { "$ref": "#/$defs/output" }
  },
  "$defs": {
    "accessScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "network", "credentials"],
      "properties": {
        "source": { "const": "immutable_snapshot" },
        "network": { "type": "string", "minLength": 1, "maxLength": 256 },
        "credentials": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "isolationScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "sourceMount",
        "sourcePermission",
        "workingDirectory",
        "writableLayer",
        "repositoryPathExposed"
      ],
      "properties": {
        "level": {
          "enum": ["sandboxed", "containerized", "no_egress_sandbox", "read_only_container", "trusted_local"]
        },
        "sourceMount": { "type": "string", "minLength": 1, "maxLength": 256 },
        "sourcePermission": { "type": "string", "minLength": 1, "maxLength": 256 },
        "workingDirectory": { "type": "string", "minLength": 1, "maxLength": 256 },
        "writableLayer": { "type": "string", "minLength": 1, "maxLength": 256 },
        "repositoryPathExposed": { "const": false }
      }
    },
    "mountPermissionEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceDelivery",
        "sourceMount",
        "workingDirectoryMode",
        "workingDirectoryPermission",
        "readOnlySource",
        "disposable",
        "repositoryPathExposed",
        "dependencyEnvironmentPreserved",
        "cleanupVerified"
      ],
      "properties": {
        "sourceDelivery": { "type": "string", "minLength": 1, "maxLength": 256 },
        "sourceMount": { "type": "string", "minLength": 1, "maxLength": 256 },
        "workingDirectoryMode": { "type": "string", "minLength": 1, "maxLength": 256 },
        "workingDirectoryPermission": { "type": "string", "minLength": 1, "maxLength": 32 },
        "readOnlySource": { "type": "boolean" },
        "disposable": { "type": "boolean" },
        "repositoryPathExposed": { "type": "boolean" },
        "dependencyEnvironmentPreserved": { "type": "boolean" },
        "cleanupVerified": { "type": "boolean" },
        "terminalModes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 64 } }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layerCreated", "layerDisposed", "verified"],
      "properties": {
        "layerCreated": { "type": "boolean" },
        "layerDisposed": { "type": "boolean" },
        "verified": { "type": "boolean" }
      }
    },
    "writeAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codeflowWriteCount", "sourceIntegrityViolation", "capturedSnapshotTreeDigest"],
      "properties": {
        "codeflowWriteCount": { "type": "integer", "minimum": 0 },
        "repositoryPathWrites": { "type": "array", "maxItems": 256, "items": { "type": "string", "minLength": 1, "maxLength": 1024 } },
        "sourceIntegrityViolation": { "type": "boolean" },
        "capturedSnapshotTreeDigest": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "concurrentWorktree": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification"],
      "properties": {
        "classification": { "enum": ["not_configured", "unchanged", "reconciled_unattributed", "reconcile_pending"] },
        "beforeSnapshotId": { "type": "string", "maxLength": 256 },
        "afterSnapshotId": { "type": "string", "maxLength": 256 },
        "beforeTreeDigest": { "type": "string", "maxLength": 256 },
        "afterTreeDigest": { "type": "string", "maxLength": 256 }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stdout": { "type": "string", "maxLength": 65536 },
        "stderr": { "type": "string", "maxLength": 65536 },
        "exitCode": { "type": "integer" },
        "truncated": { "type": "boolean" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["sourceWriteAuditStatus"],
        "properties": { "sourceWriteAuditStatus": { "enum": ["unavailable", "indeterminate"] } }
      },
      "then": { "properties": { "evidencePromotion": { "const": "blocked" } } }
    },
    {
      "if": {
        "required": ["sourceIntegrityStatus"],
        "properties": { "sourceIntegrityStatus": { "const": "source_integrity_violation" } }
      },
      "then": {
        "properties": {
          "resultCode": { "const": "source_integrity_violation" },
          "evidencePromotion": { "const": "blocked" }
        }
      }
    }
  ]
}
