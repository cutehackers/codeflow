{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeflow.local/schemas/rflsc.release-benchmark-report.v2.schema.json",
  "title": "Evidence-bound release benchmark evaluation",
  "type": "object", "additionalProperties": false,
  "required": ["schemaId", "schemaVersion", "reportId", "targetVersion", "evaluatedAt", "status", "executionRefs", "childEvidenceRefs", "metrics", "gates", "reasons", "releaseReady"],
  "properties": {
    "schemaId": {"const": "https://codeflow.local/schemas/rflsc.release-benchmark-report.v2.schema.json"}, "schemaVersion": {"const": 2},
    "reportId": {"type": "string"}, "targetVersion": {"type": "string"}, "evaluatedAt": {"anyOf": [{"type": "string", "format": "date-time"}, {"const": ""}]}, "status": {"enum": ["incomplete", "evaluated", "passed", "failed"]},
    "profileRef": {"$ref": "#/$defs/immutableRef"}, "corpusRef": {"$ref": "#/$defs/immutableRef"}, "executionRefs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/immutableRef"}}, "thresholdRef": {"$ref": "#/$defs/immutableRef"}, "childEvidenceRefs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/immutableRef"}},
    "metrics": {"type": "array", "items": {"$ref": "#/$defs/metric"}}, "gates": {"type": "array", "items": {"$ref": "#/$defs/gate"}}, "reasons": {"type": "array", "items": {"type": "string", "minLength": 1}}, "releaseReady": {"type": "boolean"}
  },
  "allOf": [
    {"if": {"properties": {"status": {"not": {"const": "incomplete"}}}, "required": ["status"]}, "then": {"properties": {"reportId": {"minLength": 1}, "targetVersion": {"minLength": 1}, "evaluatedAt": {"type": "string", "format": "date-time", "minLength": 1}}}},
    {"if": {"properties": {"status": {"const": "incomplete"}}, "required": ["status"]}, "then": {"properties": {"metrics": {"maxItems": 0}, "gates": {"maxItems": 0}, "releaseReady": {"const": false}}, "required": ["reasons"]}},
    {"if": {"properties": {"status": {"const": "passed"}}, "required": ["status"]}, "then": {"required": ["profileRef", "corpusRef", "thresholdRef"], "properties": {"executionRefs": {"minItems": 1}, "childEvidenceRefs": {"minItems": 1}, "metrics": {"minItems": 9}, "gates": {"minItems": 9}, "reasons": {"maxItems": 0}, "releaseReady": {"const": true}}}}
  ],
  "$defs": {
    "immutableRef": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "bindings": {"type": "object", "required": ["profileId", "scenarioIds", "traceIds", "toolchainIds", "evidenceRefs"], "properties": {"profileId": {"type": "string", "minLength": 1}, "scenarioIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "traceIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "toolchainIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "evidenceRefs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/immutableRef"}}}},
    "metric": {"allOf": [{"$ref": "#/$defs/bindings"}], "type": "object", "additionalProperties": false, "required": ["metric", "capabilityId", "category", "unit", "aggregation", "value", "profileId", "scenarioIds", "traceIds", "toolchainIds", "evidenceRefs"], "properties": {"metric": {"type": "string", "minLength": 1}, "capabilityId": {"type": "string", "minLength": 1}, "category": {"enum": ["latency", "quality", "resource"]}, "unit": {"type": "string", "minLength": 1}, "aggregation": {"enum": ["p95", "mean"]}, "value": {"type": "number"}, "profileId": {}, "scenarioIds": {}, "traceIds": {}, "toolchainIds": {}, "evidenceRefs": {}}},
    "gate": {"allOf": [{"$ref": "#/$defs/bindings"}], "type": "object", "additionalProperties": false, "required": ["metric", "capabilityId", "passed", "decisionRef", "thresholdRef", "profileId", "scenarioIds", "traceIds", "toolchainIds", "evidenceRefs"], "properties": {"metric": {"type": "string", "minLength": 1}, "capabilityId": {"type": "string", "minLength": 1}, "passed": {"type": "boolean"}, "decisionRef": {"type": "string", "minLength": 1}, "thresholdRef": {"$ref": "#/$defs/immutableRef"}, "profileId": {}, "scenarioIds": {}, "traceIds": {}, "toolchainIds": {}, "evidenceRefs": {}, "reason": {"type": "string", "minLength": 1}}}
  }
}
